---
import Layout from './Layout.astro';
import { cateringPackages, menuPackages, enhancements, sideOptions, additionalServices } from '../data/catering';

export interface Props {
  title: string;
  description: string;
  metaImage: string;
  canonicalUrl: string;
  cityName: string;
  structuredData: any;
  keywords?: string;
  venues?: {
    corporate: string[];
    events: string[];
  };
  faqs?: {
    question: string;
    answer: string;
  }[];
  citySpecificContent: {
    intro: string;
    locationBenefits: string[];
  };
}

const { 
  title, 
  description, 
  metaImage, 
  canonicalUrl, 
  structuredData,
  cityName,
  venues,
  faqs,
  citySpecificContent,
  keywords
} = Astro.props;

// Generate catering-specific keywords if not provided
const defaultKeywords = `Mexican catering ${cityName}, New Mexican catering ${cityName}, corporate catering ${cityName}, event catering ${cityName}, wedding catering ${cityName}, authentic Mexican food ${cityName}`;

// Enhance the structured data for catering pages
const enhancedStructuredData = {
  ...structuredData,
  "@type": ["Restaurant", "FoodEstablishment", "CateringService"],
  "areaServed": {
    "@type": "City",
    "name": cityName,
    "containedIn": "Colorado"
  },
  "hasMenu": {
    "@type": "Menu",
    "name": "Catering Menu",
    "offers": cateringPackages.map(pkg => ({
      "@type": "MenuSection",
      "name": pkg.title,
      "description": pkg.description
    }))
  }
};

// Add FAQ Schema if FAQs are provided
if (faqs && faqs.length > 0) {
  enhancedStructuredData.mainEntity = {
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  };
}
---

<Layout 
  title={title}
  description={description}
  metaImage={metaImage}
  canonicalUrl={canonicalUrl}
  keywords={keywords || defaultKeywords}
  structuredData={enhancedStructuredData}
>
  <main class="container mx-auto px-4 py-36">
    <h1 class="text-4xl font-bold text-center mb-8">{cityName}'s Premier Mexican Catering Service</h1>

    <!-- Introduction -->
    <section class="mb-12 max-w-4xl mx-auto text-center">
      <p class="text-xl mb-6">
        {citySpecificContent.intro}
      </p>
      <div class="bg-orange-50 p-6 rounded-lg mt-8">
        <h2 class="text-2xl font-semibold mb-4">{cityName}'s Choice for Mexican Catering</h2>
        <ul class="text-left space-y-2">
          {citySpecificContent.locationBenefits.map(benefit => (
            <li class="flex items-center">
              <span class="text-orange mr-2">✓</span> {benefit}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Catering Packages -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold uppercase border-b-2 border-orange mb-6 pb-2">Catering Packages</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {cateringPackages.map(pkg => (
          <div class="p-6 rounded-lg shadow-sm bg-white">
            <div class="flex justify-between items-baseline mb-2">
              <h3 class="font-semibold text-xl">{pkg.title}</h3>
              <span class="text-orange font-medium">
                ${pkg.price}{pkg.perPerson ? '/person' : ''}
              </span>
            </div>
            <p class="text-gray-600 mb-4">{pkg.description}</p>
            <ul class="space-y-2">
              {pkg.includes.map(item => (
                <li class="flex items-center text-sm">
                  <span class="text-orange mr-2">•</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Menu Packages -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold uppercase border-b-2 border-orange mb-6 pb-2">Menu Options</h2>
      <div class="grid gap-8">
        {menuPackages.map(pkg => (
          <div class="bg-white p-6 rounded-lg shadow-sm">
            <h3 class="text-xl font-semibold mb-4">{pkg.title}</h3>
            <div class="grid md:grid-cols-2 gap-6">
              {pkg.items.map(item => (
                <div class="border-b pb-4">
                  <div class="flex justify-between items-start mb-2">
                    <h4 class="font-medium">{item.name}</h4>
                    <span class="text-orange-700">${item.price}{item.perGuest ? '/guest' : ''}</span>
                  </div>
                  <p class="text-gray-600 text-sm">{item.description}</p>
                </div>
              ))}
            </div>
            {pkg.note && <p class="text-sm text-gray-500 mt-4">{pkg.note}</p>}
          </div>
        ))}
      </div>
    </section>

    <!-- Side Options -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold uppercase border-b-2 border-orange mb-6 pb-2">Side Dishes</h2>
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-xl font-semibold mb-4">Available Sides</h3>
        <div class="grid md:grid-cols-2 gap-6">
          {sideOptions.map(side => (
            <div class="border-b pb-4">
              <h4 class="font-medium mb-2">{side.name}</h4>
              <p class="text-gray-600 text-sm">{side.description}</p>
            </div>
          ))}
        </div>
        <p class="text-sm text-gray-500 mt-4">All entrees include choice of two sides. Additional sides can be added for $3 per person.</p>
      </div>
    </section>

    <!-- Enhancements -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold uppercase border-b-2 border-orange mb-6 pb-2">Enhancements</h2>
      
      <h3 class="text-xl font-semibold mb-4">Stations</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        {enhancements.stations.map(station => (
          <div class="p-4 bg-white rounded-lg shadow-sm">
            <div class="flex justify-between items-baseline mb-2">
              <span class="font-medium">{station.name}</span>
              <span class="text-orange">${station.price}/person</span>
            </div>
            <p class="text-sm text-gray-600">{station.description}</p>
          </div>
        ))}
      </div>

      <h3 class="text-xl font-semibold mb-4">Beverages</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        {enhancements.drinks.map(drink => (
          <div class="p-4 bg-white rounded-lg shadow-sm">
            <div class="flex justify-between items-baseline mb-2">
              <span class="font-medium">{drink.name}</span>
              <span class="text-orange">${drink.price}/person</span>
            </div>
            <p class="text-sm text-gray-600">{drink.description}</p>
          </div>
        ))}
      </div>

      <h3 class="text-xl font-semibold mb-4">Desserts</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        {enhancements.desserts.map(dessert => (
          <div class="p-4 bg-white rounded-lg shadow-sm">
            <div class="flex justify-between items-baseline mb-2">
              <span class="font-medium">{dessert.name}</span>
              <span class="text-orange">${dessert.price}/person</span>
            </div>
            <p class="text-sm text-gray-600">{dessert.description}</p>
          </div>
        ))}
      </div>

      <h3 class="text-xl font-semibold mb-4">Additional Options</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        {enhancements.extras.map(extra => (
          <div class="p-4 bg-white rounded-lg shadow-sm">
            <div class="flex justify-between items-baseline mb-2">
              <span class="font-medium">{extra.name}</span>
              <span class="text-orange">
                ${extra.price}{extra.perPerson ? '/person' : ''}
                {extra.serves ? ` (serves ${extra.serves})` : ''}
              </span>
            </div>
            <p class="text-sm text-gray-600">{extra.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Additional Services -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold uppercase border-b-2 border-orange mb-6 pb-2">Additional Services</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {additionalServices.map(service => (
          <div class="p-4 bg-white rounded-lg shadow-sm">
            <div class="flex justify-between items-baseline mb-2">
              <span class="font-medium">{service.name}</span>
              <span class="text-orange">${service.price}</span>
            </div>
            <p class="text-sm text-gray-600 mb-1">{service.description}</p>
            {service.note && <p class="text-sm text-orange-600 italic">{service.note}</p>}
          </div>
        ))}
      </div>
    </section>

    <!-- Service Area -->
    <section class="mb-12 bg-gray-50 p-6 rounded-lg">
      <h2 class="text-2xl font-bold uppercase border-b-2 border-orange mb-6 pb-2">Mexican Catering Service Area</h2>
      <p class="mb-4">Based in Westminster, we provide Mexican catering services to:</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="p-3 bg-white rounded shadow-sm text-center">Westminster</div>
        <div class="p-3 bg-white rounded shadow-sm text-center">
          <a href="/arvada-mexican-catering" class="hover:text-orange-600">Arvada</a>
        </div>
        <div class="p-3 bg-white rounded shadow-sm text-center">
          <a href="/broomfield-mexican-catering" class="hover:text-orange-600">Broomfield</a>
        </div>
        <div class="p-3 bg-white rounded shadow-sm text-center">
          <a href="/thornton-mexican-catering" class="hover:text-orange-600">Thornton</a>
        </div>
        <div class="p-3 bg-white rounded shadow-sm text-center">
          <a href="/northglenn-mexican-catering" class="hover:text-orange-600">Northglenn</a>
        </div>
        <div class="p-3 bg-white rounded shadow-sm text-center">
          <a href="/denver-mexican-catering" class="hover:text-orange-600">Denver</a>
        </div>
        <div class="p-3 bg-white rounded shadow-sm text-center">
          <a href="/louisville-mexican-catering" class="hover:text-orange-600">Louisville</a>
        </div>
        <div class="p-3 bg-white rounded shadow-sm text-center">
          <a href="/lafayette-mexican-catering" class="hover:text-orange-600">Lafayette</a>
        </div>
        <div class="p-3 bg-white rounded shadow-sm text-center">
          <a href="/commerce-city-mexican-catering" class="hover:text-orange-600">Commerce City</a>
        </div>
      </div>
      <p class="text-sm text-gray-600 mt-4">* Delivery fees may apply based on distance</p>
    </section>

    {venues && (
      <!-- Popular Venues Section -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold uppercase border-b-2 border-orange mb-6 pb-2">Popular {cityName} Catering Venues</h2>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-sm">
            <h3 class="text-xl font-semibold mb-4 text-orange-700">Corporate Venues</h3>
            <ul class="space-y-3">
              {venues.corporate.map(venue => (
                <li class="flex items-center gap-2">
                  <span class="text-orange-400 text-lg">•</span>
                  <span>{venue}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-sm">
            <h3 class="text-xl font-semibold mb-4 text-orange-700">Event Spaces</h3>
            <ul class="space-y-3">
              {venues.events.map(venue => (
                <li class="flex items-center gap-2">
                  <span class="text-orange-400 text-lg">•</span>
                  <span>{venue}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <p class="text-center text-gray-600 mt-6">
          We're experienced in serving these venues and many more throughout {cityName}. Contact us to discuss your specific venue needs.
        </p>
      </section>
    )}

    {faqs && (
      <!-- FAQ Section -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold uppercase border-b-2 border-orange mb-6 pb-2">Frequently Asked Questions About Our {cityName} Catering</h2>
        <div class="space-y-6">
          {faqs.map(faq => (
            <div class="bg-white p-6 rounded-lg shadow-sm">
              <h3 class="font-semibold text-lg mb-2">{faq.question}</h3>
              <p class="text-gray-600">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Contact Information -->
    <section class="text-center mt-12 bg-orange-50 p-8 rounded-lg">
      <h2 class="text-2xl font-bold mb-6">Book Your Mexican Catering in {cityName}</h2>
      <p class="mb-4">Contact {cityName}'s favorite Mexican caterers:</p>
      <p class="mb-2">Call: <a href="tel:7207978897" class="text-orange hover:underline">(720) 797-8897</a></p>
      <p>Email: <a href="mailto:catering@rositas.biz" class="text-orange hover:underline">catering@rositas.biz</a></p>
      <p class="font-medium mt-4">Conveniently located at: 8050 N Federal Blvd, Westminster, CO 80031</p>
      <p class="text-sm text-gray-600 mt-4">Available Monday-Friday 9am-5pm</p>
    </section>

    <!-- Additional Information -->
    <section class="mt-12 text-sm text-gray-600">
      <p class="mb-2">• 30% non-refundable deposit required to reserve date</p>
      <p class="mb-2">• Final balance due 10 business days before event</p>
      <p class="mb-2">• We accept all major credit cards, cash, and checks</p>
      <p>• Prices subject to change. Please contact us for current pricing and availability.</p>
    </section>
  </main>
</Layout> 