    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "8050 Federal Blvd",
      "addressLocality": "Westminster",
      "addressRegion": "CO",
      "postalCode": "80031",
      "addressCountry": "US"
    },
    "serviceArea": {
      "@type": "GeoCircle",
