    "@type": ["FoodEstablishment", "CateringService"],
    "name": "Rosita's New Mexican Cafe - Northglenn Catering",
    "image": "https://rositascafe.com/rositas-catering-northglenn.jpg",
    "description": "Premium Mexican and New Mexican catering services in Northglenn, specializing in community events, corporate functions, and local gatherings. Serving Webster Lake, E.B. Rains Memorial Park, and surrounding areas.",
    "url": "https://rositascafe.com/northglenn-mexican-catering",
    "telephone": "+1-303-430-9155",
    "priceRange": "$$",
    "servesCuisine": ["New Mexican", "Mexican", "Catering"],
    "aggregateRating": {
      "@type": "AggregateRating",
