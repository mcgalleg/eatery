        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "EventVenue",
    "name": "Northglenn Catering Venues",
    "events": venues.events.map(venue => ({
      "@type": "Event",
      "name": `Catering at ${venue}`,
      "startDate": "2024-01-01T00:00:00",
      "endDate": "2024-12-31T23:59:59",
      "location": {
        "@type": "Place",
        "name": venue,
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Northglenn",
          "addressRegion": "CO",
          "addressCountry": "US"
        }
      },
      "offers": {
        "@type": "Offer",
        "availability": "https://schema.org/InStock",
        "availabilityStarts": "2024-01-01",
        "availabilityEnds": "2024-12-31"
      }
    }))
  }
];
---

<CateringLayout
  title={pageTitle}
  description={pageDescription}
  metaImage="/images/northglenn-catering-hero.jpg"
  canonicalUrl="/northglenn-mexican-catering"
  cityName={cityName}
  keywords={pageKeywords}
  structuredData={northglennStructuredData}
  venues={venues}
  faqs={faqs}
  citySpecificContent={citySpecificContent}
>
  <!-- Page content will go here -->
</CateringLayout> 