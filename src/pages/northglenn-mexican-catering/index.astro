---
import CateringLayout from '../../layouts/CateringLayout.astro';

const cityName = "Northglenn";
const pageTitle = "Northglenn Mexican Catering | Webster Lake & E.B. Rains Event Specialists";
const pageDescription = "Quick Mexican catering delivery across Northglenn. Trusted caterer for Webster Lake businesses, E.B. Rains events, and Northglenn Recreation Center gatherings. Local expertise in authentic Southwest cuisine from your neighborhood catering team.";
const pageKeywords = "Northglenn Mexican catering, Webster Lake corporate catering, E.B. Rains event food, Northglenn Recreation Center catering, Northglenn Marketplace catering, authentic Mexican catering Northglenn CO";

const citySpecificContent = {
  intro: "Your local Northglenn catering experts, perfectly positioned to serve the entire community with authentic Southwest and New Mexican cuisine. From corporate lunches at Webster Lake to community celebrations at E.B. Rains Jr. Memorial Park, we bring the flavors of Mexico to your Northglenn gathering.",
  locationBenefits: [
    "Quick delivery throughout Northglenn",
    "Webster Lake & 120th Ave specialists",
    "Experienced Recreation Center caterer",
    "Community event expertise",
    "Local family business since 1985"
  ]
};

const venues = {
  corporate: [
    "Webster Lake Promenade",
    "Northglenn Marketplace",
    "120th Avenue Business District",
    "Washington Street Plaza"
  ],
  events: [
    "Northglenn Recreation Center",
    "E.B. Rains Jr. Memorial Park",
    "D.L. Parsons Theatre",
    "Northglenn Senior Center"
  ]
};

const faqs = [
  {
    question: "What areas of Northglenn do you serve?",
    answer: "We serve all of Northglenn, including Webster Lake, E.B. Rains area, and the 120th Avenue corridor. Our central location allows us to quickly reach any Northglenn venue with hot, fresh Mexican food."
  },
  {
    question: "How far in advance should I book catering in Northglenn?",
    answer: "For Northglenn events, we recommend booking 2 weeks in advance, especially for community centers and corporate functions. Peak seasons and large events may require more advance notice."
  },
  {
    question: "Do you offer special rates for Northglenn businesses?",
    answer: "Yes! We offer corporate rates for Northglenn businesses, especially for regular catering services. We're proud to serve many businesses in the Webster Lake area and along the 120th Avenue corridor."
  },
  {
    question: "What's your delivery time within Northglenn?",
    answer: "Most Northglenn locations can expect delivery within 20-30 minutes. We're strategically located to serve all of Northglenn efficiently, ensuring your food arrives hot and fresh."
  },
  {
    question: "Do you cater outdoor events in Northglenn parks?",
    answer: "Absolutely! We regularly cater at E.B. Rains Jr. Memorial Park and other Northglenn outdoor venues. We provide appropriate setup for outdoor catering, including covered serving stations when needed."
  }
];

// Enhanced structured data specific to Northglenn catering
const northglennStructuredData = [
