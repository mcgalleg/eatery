---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeaturedCards from '../components/FeaturedCards.astro';

/* Define your card data here */
const cards = [
    /*
    {
        title: "Breakfast & Brunch in Westminster",
        subtitle: "NOW SERVING FRESH CLASSICS",
        description:
            "We are excited to debut our revamped Breakfast Westminster experience! Enjoy breakfast favorites like fluffy pancakes, French toast, Omlets and freshly baked pastries—perfectly paired with locally sourced Sweet Bloom coffee. Start your day right in Westminster with our unique twist on breakfast.",
        image: "/pancakes.jpg",
        link: "/menu#breakfast",
        buttonText: "SEE NEW MENU",
    },
    */
    {
        title: "Southwest Breakfast in Westminster",
        subtitle: "NOW SERVING FRESH CLASSIC SOUTHWEST BREAKFAST",
        description:
            "Experience the Southwest with our signature breakfast dishes. Start your day with our famous Huevos Rancheros, featuring perfectly cooked eggs smothered in our delcious green chile. Or try our Enchilada Ranchera with eggs - a hearty combination of corn tortillas, melted cheese, and red chile, topped with eggs.",
        image: "/country-fried-steak-eggs.jpg",

    },
    {
        title: "Southwest Breakfast Burritos",
        subtitle: "MADE TO ORDER FRESH",
        description:
            "Get your day started with a hearty Southwest Breakfast Burrito, packed with fluffy scrambled eggs, our famous potatoes and green chile, and your choice of protein - from bacon and chorizo to tender carnitas! Available for dine-in, takeout, or delivery.",
        image: "/breakfast-burritos.jpg",

    },
   
    /*
    {
        title: "Sweet Bloom Coffee now at Rosita's Cafe",
        description:
            "We are thrilled to announce an exciting new partnership with Sweet Bloom Coffee Roasters, a name synonymous with exceptional coffee quality and craft in the Denver area. Starting this week, we will be serving Sweet Bloom's exquisite coffee, bringing a taste of their renowned expertise directly to your table.",
        image: "/coffee.jpg",
        link: "/menu#drinks",
    },*/
    {
        title: "Get Your Order Delivered",
        subtitle: "FREE SOPAPILLA'S WHEN ORDERING DIRECT",
        description:
            "The food and drinks you love, delivered right to your door. Save up to 20% when you order directly through our website when compared to ordering through other delivery services! Order what you're craving and we'll throw in a free Sopapilla with your order when you use promo code 'SOPA'.",
        image: "/Rositas-Delivery-Takeout.jpg",
        link: "https://order.toasttab.com/online/rositas",
        buttonText: "ORDER NOW",
