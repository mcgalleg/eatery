---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeaturedCards from '../components/FeaturedCards.astro';

/* Define your card data here */
const cards = [
    {
        title: "Breakfast & Brunch in Westminster",
        subtitle: "NOW SERVING FRESH CLASSICS",
        description:
            "We are excited to debut our revamped Breakfast Westminster experience! Enjoy American breakfast favorites like fluffy pancakes, French toast, and freshly baked pastries—perfectly paired with locally sourced coffee. Start your day right in Westminster with our unique twist on breakfast.",
        image: "/pancakes.jpg",
        link: "/menu#breakfast",
        buttonText: "SEE NEW MENU",
    },
    {
        title: "Sweet Bloom Coffee now at Rosita's",
        description:
            "We are thrilled to announce an exciting new partnership with Sweet Bloom Coffee Roasters, a name synonymous with exceptional coffee quality and craft in the Denver area. Starting this week, we will be serving Sweet Bloom's exquisite coffee, bringing a taste of their renowned expertise directly to your table.",
        image: "/coffee.jpg",
        link: "/menu#drinks",
    },
    {
        title: "Get Your Order Delivered",
        subtitle: "ORDER FROM US AND SAVE",
        description:
            "The food and drinks you love, delivered right to your door. Save up to 20% when you order directly through our website when compared to ordering through other delivery services! Order what you're craving without leaving your couch.",
        image: "/Rositas-menu.webp",
        link: "/order",
        buttonText: "ORDER NOW",
    },
];

export const frontmatter = {
	title: "Breakfast Westminster | Rosita's New Mexican Cafe",
	description: "Experience the best Breakfast Westminster at Rosita's New Mexican Cafe. Indulge in a mouth-watering breakfast and brunch menu, where authentic flavors meet modern flair in the heart of Westminster.",
	metaImage: "/rositas-restaurant.jpg",
	canonicalUrl: "https://rositas.biz",
	structuredData: {
		"@context": "https://schema.org",
		"@type": "Restaurant",
		"name": "Rosita's New Mexican Cafe",
		"image": "/rositas-restaurant.jpg",
		"telephone": "+1-303-430-9155",
		"address": {
			"@type": "PostalAddress",
			"streetAddress": "8050 Federal Blvd",
			"addressLocality": "Westminster",
			"addressRegion": "CO",
			"postalCode": "80031",
			"addressCountry": "US"
		},
		"url": "https://rositas.biz",
		"priceRange": "$$",
		"servesCuisine": ["New Mexican", "Mexican", "American", "Breakfast", "Brunch"]
	}
};
---

<Layout {...frontmatter}>
  <Hero />
  <FeaturedCards cards={cards} />
  <!-- Other content here -->
</Layout>
