];

export const frontmatter = {
	title: "Breakfast Westminster | Best Breakfast Burritos | Rosita's",
	description: "Looking for the best breakfast in Westminster? Rosita's New Mexican Cafe serves up authentic Southwest breakfast, including our famous breakfast burritos!  Homemade green chile, pan fried potatoes, and more.",
	metaImage: "/rositas-restaurant.jpg",
	canonicalUrl: "https://rositas.biz",
	structuredData: {
		"@context": "https://schema.org",
		"@type": "Restaurant",
		"name": "Rosita's New Mexican Cafe",
		"image": "/rositas-restaurant.jpg",
		"telephone": "+1-303-430-9155",
		"address": {
			"@type": "PostalAddress",
			"streetAddress": "8050 Federal Blvd",
			"addressLocality": "Westminster",
			"addressRegion": "CO",
			"postalCode": "80031",
			"addressCountry": "US"
		},
		"url": "https://rositas.biz",
		"priceRange": "$$",
		"servesCuisine": ["New Mexican", "Mexican", "American", "Breakfast", "Brunch"],
		"hasMenu": "https://rositas.biz/menu",
		"acceptsReservations": "false",
		"openingHoursSpecification": [
			{
				"@type": "OpeningHoursSpecification",
				"dayOfWeek": [
          "Sunday",
					"Monday",
					"Tuesday",
					"Wednesday",
					"Thursday",
					"Friday",
					"Saturday",
				],
				"opens": "07:00",
				"closes": "20:00"
			},
		],
		"potentialAction": {
			"@type": "OrderAction",
			"target": {
				"@type": "EntryPoint",
				"urlTemplate": "https://order.toasttab.com/online/rositas"
			},
			"deliveryMethod": [{"@type": "DeliveryMethod", "name": "Direct"},{"@type":"DeliveryMethod", "name":"Third Party"}]
		},
		"aggregateRating": {
			"@type": "AggregateRating",
			"ratingValue": 4.8,
			"reviewCount": 1184
		}
	}
};
---

<Layout {...frontmatter}>
  <Hero />
  <FeaturedCards cards={cards} />

    <div class="container mx-auto px-4 pb-16">
        <h2 class="text-3xl font-bold text-center mb-4">Best Unique Breakfast in Westminster</h2>
        <p class="text-lg text-center mb-6">
            At Rosita's, we're passionate about serving the best Southwest breakfast in Westminster.  We use fresh, high-quality ingredients and traditional recipes to create the breakfast satisfaction you're looking for.  Our breakfast burritos are a local favorite, made with our famous green chile smothered in our signature sauce. And if you'd like some pancakes and bacon, we have you covered there too!
        </p>
        <p class="text-lg text-center mb-6">
            Whether you're craving a classic breakfast, a modern brunch twist, or an innovative spin on morning favorites, Rosita's is your premier destination for extraordinary breakfast and brunch experiences in Westminster.
        </p>
        <h3 class="text-2xl font-bold text-center mb-2">Our Breakfast Burrito Specialties</h3>
        <ul class="list-disc list-inside text-center">
            <li><strong>Classic Breakfast Burrito:</strong> Scrambled eggs, potatoes, cheese, and your choice of bacon, sausage, or chorizo.</li>
            <li><strong>Green Chile Smothered Burrito:</strong>  Our classic breakfast burrito, smothered in our award-winning green chile.</li>
            <li><strong>Super Breakfast Burrito:</strong> Breakfast burrito smothered in our green chile, topped with lettuce, cheese and tomatoes.</li>
        </ul>
    </div>

  <!-- New container added at the bottom of the page -->
  <div style="width: 100vw; background: url('/texture-transparent.webp') repeat, orange; padding-left: 2rem; padding-right: 2rem; padding-top: 5rem; padding-bottom: 7rem;">
    <h2 style="text-align: center; color: white; font-size: xx-large;">
      NEW MEXICAN FOOD RECIPES PASSED DOWN SINCE 1963
    </h2>
    <p style="text-align: center; color: white; font-size: x-large;">
      Rosita's Mexican Restaurant has a rich history dating back to 1963, when it was founded by Paul Ortega in a small space on West Colfax. Known affectionately as little Rosita's, the restaurant quickly gained a following thanks to Paul's commitment to perfecting traditional New Mexican recipes passed down from his family...
    </p>
    <div style="text-align: center; margin-top: 1rem;">
      <a href="/our-story" class="inline-block bg-white text-grey text-center py-4 px-8 rounded-full text-lg font-semibold hover:bg-grey hover:text-white transition-colors duration-300 w-full md:w-auto">
        Our Story
      </a>
    </div>
  </div>
</Layout>
