        link: "mailto:hiring@rositas.biz",
        buttonText: "APPLY NOW",
    },
];

export const frontmatter = {
	title: "Best Southwest Mexican Breakfast in Westminster, CO | Rosita's Cafe",
	description: "Experience Westminster's best Southwest Mexican breakfast at Rosita's Cafe. Famous breakfast burritos, homemade green chile, and Southwest Mexican breakfast since 1963. Order online for delivery or takeout!",
	metaImage: "/rositas-restaurant-westminster.webp",
	canonicalUrl: "https://rositas.biz",
	structuredData: {
		"@context": "https://schema.org",
		"@type": "Restaurant",
		"name": "Rosita's Cafe",
		"image": "/rositas-restaurant-westminster.webp",
		"telephone": "+1-303-430-9155",
