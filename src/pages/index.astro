          "Sunday",
					"Monday",
					"Tuesday",
					"Wednesday",
					"Thursday",
					"Friday",
					"Saturday",
				],
				"opens": "07:00",
				"closes": "20:00"
			},
		],
		"potentialAction": {
			"@type": "OrderAction",
			"target": {
				"@type": "EntryPoint",
				"urlTemplate": "https://order.toasttab.com/online/rositas"
			},
			"deliveryMethod": [{"@type": "DeliveryMethod", "name": "Direct"},{"@type":"DeliveryMethod", "name":"Third Party"}]
		},
		"aggregateRating": {
			"@type": "AggregateRating",
			"ratingValue": 4.8,
			"reviewCount": 1184
		},
		"keywords": [
			"Southwest Mexican breakfast Westminster",
			"best breakfast burritos Westminster",
			"Mexican restaurant Westminster",
			"green chile Westminster",
			"breakfast restaurant Westminster CO",
			"authentic Mexican breakfast",
			"breakfast delivery Westminster",
			"family restaurant Westminster"
		],
		"slogan": "Westminster's Best Southwest Mexican Breakfast Since 1963",
		"areaServed": {
			"@type": "City",
			"name": "Westminster",
			"state": "Colorado"
		},
		"menu": {
			"@type": "Menu",
			"name": "Breakfast Menu",
