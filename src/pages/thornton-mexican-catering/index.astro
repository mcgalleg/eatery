---
import CateringLayout from '../../layouts/CateringLayout.astro';

const cityName = "Thornton";
const pageTitle = "Thornton Mexican Catering | Authentic Southwest Cuisine Near I-25 & 120th";
const pageDescription = "Local Mexican catering in Thornton with quick delivery. Specializing in corporate lunches, community events, and private parties across North Thornton, Washington Square, and Original Thornton. Family-owned with 35+ years of catering excellence.";
const pageKeywords = "Thornton Mexican catering, North Thornton catering service, Washington Square corporate lunch, Original Thornton event catering, I-25 corridor catering, Trail Winds Recreation Center catering, Carpenter Recreation Center food service, authentic Mexican catering Thornton CO";

const citySpecificContent = {
  intro: "Your local Thornton Mexican catering experts, strategically located near I-25 & 120th for quick 20-30 minute delivery to all Thornton areas. For over 35 years, we've been the trusted choice for authentic Southwest and New Mexican cuisine at Thornton's corporate lunches, community gatherings, and special events.",
  locationBenefits: [
    "Quick delivery to all Thornton locations",
    "Strategically located near I-25 & 120th Avenue",
    "Specialized corporate lunch packages",
    "Experienced with Thornton's major venues",
    "Local family-owned business since 1985"
  ]
};

const venues = {
  corporate: [
    "North Valley Tech Center",
    "Washington Center",
    "Thornton Business Center",
    "Grant Street Plaza"
  ],
  events: [
    "Carpenter Recreation Center",
    "Margaret W. Carpenter Park",
    "Thornton Community Center",
    "Trail Winds Recreation Center"
  ]
};

const faqs = [
  {
    question: "What areas of Thornton do you serve?",
    answer: "We serve all of Thornton, including North Thornton, Washington Square, and Original Thornton areas. Our central location allows us to quickly reach any Thornton venue with hot, fresh Mexican food."
  },
  {
    question: "How far in advance should I book catering in Thornton?",
    answer: "For Thornton events, we recommend booking 2-3 weeks in advance, especially for community centers and corporate functions. Peak seasons and large events may require more advance notice."
  },
  {
    question: "Do you offer special rates for Thornton businesses?",
    answer: "Yes! We offer corporate rates for Thornton businesses, especially for regular catering services. We're proud to serve many businesses throughout Thornton's growing commercial districts."
  },
  {
    question: "What's your delivery time within Thornton?",
    answer: "Most Thornton locations can expect delivery within 20-30 minutes. We're strategically located to serve all of Thornton efficiently, ensuring your food arrives hot and fresh."
  },
  {
    question: "Do you cater outdoor events in Thornton?",
    answer: "Absolutely! We regularly cater at Margaret W. Carpenter Park, Thornton Community Park, and other Thornton outdoor venues. We provide appropriate setup for outdoor catering, including covered serving stations when needed."
  }
];

// Enhanced structured data specific to Thornton catering
