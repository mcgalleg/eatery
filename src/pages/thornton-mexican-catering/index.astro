---

<CateringLayout
  title={pageTitle}
  description={pageDescription}
  metaImage="/images/thornton-catering-hero.jpg"
  canonicalUrl="/thornton-mexican-catering"
  cityName={cityName}
  keywords={pageKeywords}
  structuredData={thorntonStructuredData}
  venues={venues}
  faqs={faqs}
  citySpecificContent={citySpecificContent}
>
  <!-- Page content will go here -->
