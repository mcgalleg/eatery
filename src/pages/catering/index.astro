---
import CateringLayout from '../../layouts/CateringLayout.astro';

const cityName = "Westminster";
const pageTitle = "Westminster Mexican Catering | Rosita's Local Catering Service";
const pageDescription = "Westminster's trusted Mexican catering service. Authentic New Mexican cuisine for events near Federal Blvd & 80th. Serving Westminster businesses, venues & homes with local delivery. Book your Westminster catering today!";
const pageKeywords = "Westminster Mexican catering, Westminster corporate catering, Westminster wedding catering, Federal Heights catering, Church Ranch catering, authentic Mexican food Westminster, New Mexican catering Westminster";

const citySpecificContent = {
  intro: "Discover Westminster's premier Mexican catering service, conveniently located on Federal Blvd near 80th Ave. For 35 years, Rosita's has been the trusted choice for authentic Southwest and New Mexican cuisine in Westminster and the north Denver metro area.",
  locationBenefits: [
    "Proudly serving Westminster for over 35 years",
    "Convenient Federal Blvd location near 80th Ave",
    "Local Westminster family-owned business",
    "Fast delivery throughout Westminster",
    "Perfect for Westminster business parks & venues"
  ]
};

const venues = {
  corporate: [
    "Westmoor Technology Park",
    "Church Ranch Office Park",
    "Westminster Promenade",
    "Circle Point Corporate Center"
  ],
  events: [
    "Church Ranch Event Center",
    "The Westin Westminster",
    "Legacy Ridge Golf Course",
    "Westminster City Park"
  ]
};

const faqs = [
  {
    question: "What areas of Westminster do you serve?",
    answer: "We serve all of Westminster, from Federal Heights to Standley Lake, and everywhere in between. Our central location on Federal Blvd allows us to quickly reach any Westminster venue with hot, fresh Mexican food."
  },
  {
    question: "How far in advance should I book catering in Westminster?",
    answer: "For Westminster events, we recommend booking at least 2 weeks in advance, especially for popular venues like the Church Ranch Event Center or large corporate events. Peak seasons may require more advance notice."
  },
  {
    question: "Do you offer special rates for Westminster businesses?",
    answer: "Yes! We offer corporate rates for Westminster businesses, especially for regular catering services. We're proud to serve many businesses in Westminster's tech corridor and retail centers."
  },
  {
    question: "What's your delivery time within Westminster?",
    answer: "Most Westminster locations can expect delivery within 20-30 minutes. Being centrally located in Westminster allows us to provide quick, efficient service to all areas."
  },
  {
    question: "Do you cater outdoor events in Westminster parks?",
    answer: "Absolutely! We regularly cater at Westminster City Park, Standley Lake, and other Westminster outdoor venues. We provide appropriate setup for outdoor catering, including covered serving stations when needed."
  }
];

// Enhanced structured data specific to Westminster catering
const westminsterStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": ["Restaurant", "FoodEstablishment", "CateringService"],
    "name": "Rosita's New Mexican Cafe - Westminster Catering",
    "image": "/rositas-catering-westminster.jpg",
    "telephone": "+1-303-430-9155",
    "priceRange": "$$",
    "servesCuisine": ["New Mexican", "Mexican", "Catering"],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.8",
      "reviewCount": "127",
      "bestRating": "5"
    },
    "areaServed": {
      "@type": "City",
      "name": "Westminster",
      "containedIn": "Colorado"
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "8050 Federal Blvd",
      "addressLocality": "Westminster",
      "addressRegion": "CO",
      "postalCode": "80031",
      "addressCountry": "US"
    },
    "serviceArea": {
      "@type": "GeoCircle",
      "geoMidpoint": {
        "@type": "GeoCoordinates",
        "latitude": "39.8441",
        "longitude": "-105.0242"
      },
      "geoRadius": "15000"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Westminster Mexican Catering Services",
    "provider": {
      "@type": "FoodEstablishment",
      "name": "Rosita's New Mexican Cafe"
    },
    "areaServed": {
      "@type": "City",
      "name": "Westminster",
      "containedIn": "Colorado"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Catering Packages",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "FoodService",
            "name": "Full-Service Catering",
            "description": "Complete catering service including setup, service, and cleanup"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "FoodService",
            "name": "Corporate Event Catering",
            "description": "Specialized service for Westminster businesses and corporate events"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "FoodService",
            "name": "Drop-off Catering",
            "description": "Fresh Mexican food delivered to your Westminster location"
          }
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "EventVenue",
    "name": "Westminster Catering Venues",
    "events": venues.events.map(venue => ({
      "@type": "Event",
      "name": `Catering at ${venue}`,
      "startDate": "2024-01-01T00:00:00",
      "endDate": "2024-12-31T23:59:59",
      "location": {
        "@type": "Place",
        "name": venue,
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Westminster",
          "addressRegion": "CO",
          "addressCountry": "US"
        }
      },
      "offers": {
        "@type": "Offer",
        "availability": "https://schema.org/InStock",
        "availabilityStarts": "2024-01-01",
        "availabilityEnds": "2024-12-31"
      }
    }))
  }
];
---

<CateringLayout
  title={pageTitle}
  description={pageDescription}
  metaImage="/images/westminster-catering-hero.jpg"
  canonicalUrl="/westminster-mexican-catering"
  cityName={cityName}
  keywords={pageKeywords}
  structuredData={westminsterStructuredData}
  venues={venues}
  faqs={faqs}
  citySpecificContent={citySpecificContent}
>
  <!-- Page content will go here -->
</CateringLayout> 