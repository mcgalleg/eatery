};

const faqs = [
  {
    question: "What areas of Thornton do you serve?",
    answer: "We serve all of Thornton, from Original Thornton to North Creek Farms, including the Outlet Mall area and surrounding communities. Our location allows us to quickly reach any Thornton venue with hot, fresh Mexican food."
  },
  {
    question: "How far in advance should I book catering in Thornton?",
