---
import CateringLayout from '../../layouts/CateringLayout.astro';

const cityName = "Denver";

const citySpecificContent = {
  intro: "Discover Denver's premier Mexican catering service, serving North Denver and beyond. For over 35 years, Rosita's has been the trusted choice for authentic Southwest and New Mexican cuisine in the Mile High City and surrounding areas.",
  locationBenefits: [
    "Fast service to North Denver & downtown",
    "Easy access to I-70 & I-25",
    "Serving Denver for over 35 years",
    "Perfect for Denver businesses & venues",
    "Local family-owned business"
  ]
};

const venues = {
  corporate: [
    "Denver Tech Center",
    "Union Station",
    "RiNo Office Hub",
    "Downtown Business District"
  ],
  events: [
    "EXDO Event Center",
    "Mile High Station",
    "Broncos Stadium",
    "Denver Botanic Gardens"
  ]
};

const faqs = [
  {
    question: "What areas of Denver do you serve?",
    answer: "We primarily serve North Denver, LoDo, RiNo, and the Denver Tech Center areas. Our location allows us to quickly reach any Denver venue with hot, fresh Mexican food, with special focus on downtown and northern neighborhoods."
  },
  {
    question: "How far in advance should I book catering in Denver?",
    answer: "For Denver events, we recommend booking at least 2-3 weeks in advance, especially for popular downtown venues or large corporate events. Major venues like Broncos Stadium or Denver Botanic Gardens may require more advance notice."
  },
  {
    question: "Do you offer special rates for Denver businesses?",
    answer: "Yes! We offer corporate rates for Denver businesses, especially for regular catering services. We're proud to serve many businesses in Denver's tech corridor, downtown district, and emerging business areas."
  },
  {
    question: "What's your delivery time within Denver?",
    answer: "Delivery times vary by location within Denver. North Denver locations can expect delivery within 30-45 minutes, while downtown and Tech Center deliveries may take 45-60 minutes depending on traffic. We plan carefully around Denver's rush hours."
  },
  {
    question: "Do you cater outdoor events in Denver parks?",
    answer: "Absolutely! We regularly cater at City Park, Sloan's Lake Park, Commons Park, and other Denver outdoor venues. We provide appropriate setup for outdoor catering, including covered serving stations when needed."
  }
];

const frontmatter = {
  title: "Denver Mexican Catering | Rosita's Local Catering Service",
  description: "Denver's trusted Mexican catering service. Authentic New Mexican cuisine for events in LoDo, RiNo & Denver Tech Center. Serving North Denver businesses & venues. Book your Denver catering today!",
  metaImage: "/rositas-catering.webp",
  canonicalUrl: "https://rositas.biz/catering/denver",
  structuredData: {
    "@context": "https://schema.org",
    "@type": "FoodService",
    "name": "Rosita's Mexican Catering Denver",
    "image": "/rositas-catering.webp",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "8050 N Federal Blvd",
      "addressLocality": "Westminster",
      "addressRegion": "CO",
      "postalCode": "80031",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "39.8441",
      "longitude": "-105.0242"
    },
    "priceRange": "$$",
    "servesCuisine": ["Mexican", "New Mexican", "Southwestern", "Catering"],
    "areaServed": ["North Denver", "LoDo", "RiNo", "Denver Tech Center"],
    "telephone": "720-797-8897",
    "email": "catering@rositas.biz",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.8",
      "reviewCount": "127"
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "07:00",
      "closes": "20:00"
    },
    "hasMenu": {
      "@type": "Menu",
      "name": "Catering Menu",
      "url": "https://rositas.biz/catering/denver"
    }
  }
};
---

<CateringLayout
  title={frontmatter.title}
  description={frontmatter.description}
  metaImage={frontmatter.metaImage}
  canonicalUrl={frontmatter.canonicalUrl}
  structuredData={frontmatter.structuredData}
  cityName={cityName}
  venues={venues}
  faqs={faqs}
  citySpecificContent={citySpecificContent}
/> 