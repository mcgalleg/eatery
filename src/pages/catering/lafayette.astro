    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "39.8441",
      "longitude": "-105.0242"
    },
    "priceRange": "$$",
    "servesCuisine": ["Mexican", "New Mexican", "Southwestern", "Catering"],
    "areaServed": ["Lafayette", "Old Town Lafayette", "Indian Peaks"],
    "telephone": "720-797-8897",
    "email": "catering@rositas.biz",
    "aggregateRating": {
      "@type": "AggregateRating",
