    "Indiana Business Center"
  ],
  events: [
    "Arvada Center",
    "Olde Town Square",
    "Rolling Hills Country Club",
    "Indian Tree Golf Club"
  ]
};

const faqs = [
  {
    question: "What areas of Arvada do you serve?",
    answer: "We serve all of Arvada, from Olde Town to West Arvada, including Candelas and surrounding areas. Our location allows us to quickly reach any Arvada venue with hot, fresh Mexican food."
  },
  {
    question: "How far in advance should I book catering in Arvada?",
    answer: "For Arvada events, we recommend booking at least 2 weeks in advance, especially for popular venues like the Arvada Center or large corporate events. Peak seasons may require more advance notice."
  },
  {
