---
import CateringLayout from '../../layouts/CateringLayout.astro';

const cityName = "Arvada";

const citySpecificContent = {
  intro: "Discover Arvada's premier Mexican catering service, serving Olde Town and beyond. For over 35 years, Rosita's has been the trusted choice for authentic Southwest and New Mexican cuisine in Arvada and the surrounding communities.",
