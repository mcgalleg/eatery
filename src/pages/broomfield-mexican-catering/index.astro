];
---

<CateringLayout
  title={pageTitle}
  description={pageDescription}
  metaImage="/images/broomfield-catering-hero.jpg"
  canonicalUrl="/broomfield-mexican-catering"
  cityName={cityName}
  keywords={pageKeywords}
  structuredData={broomfieldStructuredData}
  venues={venues}
  faqs={faqs}
  citySpecificContent={citySpecificContent}
>
  <!-- Page content will go here -->
</CateringLayout> 