    "telephone": "+1-303-430-9155",
    "priceRange": "$$",
    "servesCuisine": ["New Mexican", "Mexican", "Catering"],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.8",
      "reviewCount": "127",
      "bestRating": "5"
    },
    "areaServed": {
      "@type": "City",
      "name": "Broomfield",
      "containedIn": "Colorado"
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "8050 Federal Blvd",
      "addressLocality": "Westminster",
      "addressRegion": "CO",
      "postalCode": "80031",
      "addressCountry": "US"
    },
    "serviceArea": {
      "@type": "GeoCircle",
      "geoMidpoint": {
        "@type": "GeoCoordinates",
        "latitude": "39.9205",
        "longitude": "-105.0867"
      },
      "geoRadius": "15000"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Broomfield Mexican Catering Services",
    "provider": {
      "@type": "FoodEstablishment",
      "name": "Rosita's New Mexican Cafe"
    },
    "areaServed": {
      "@type": "City",
      "name": "Broomfield",
      "containedIn": "Colorado"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Catering Packages",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "FoodService",
            "name": "Corporate Catering",
            "description": "Specialized service for Broomfield businesses and tech companies"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "FoodService",
            "name": "Full-Service Catering",
            "description": "Complete catering service including setup, service, and cleanup"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "FoodService",
            "name": "Drop-off Catering",
            "description": "Fresh Mexican food delivered to your Broomfield location"
          }
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "EventVenue",
    "name": "Broomfield Catering Venues",
    "events": venues.events.map(venue => ({
      "@type": "Event",
      "location": {
        "@type": "Place",
        "name": venue,
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Broomfield",
          "addressRegion": "CO",
          "addressCountry": "US"
        }
      },
      "offers": {
        "@type": "Offer",
        "availability": "https://schema.org/InStock",
        "availabilityStarts": "2024-01-01",
        "availabilityEnds": "2024-12-31"
      }
    }))
