    "url": "https://rositascafe.com/commerce-city-mexican-catering",
    "telephone": "+1-303-430-9155",
    "priceRange": "$$",
    "servesCuisine": ["New Mexican", "Mexican", "Catering"],
    "aggregateRating": {
      "@type": "AggregateRating",
