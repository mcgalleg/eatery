---

<Layout title="Rosita's - New Mexican Cafe">

  <main class="container mx-auto px-4 py-36">
    <!-- Menu Sections -->
    {sections.map(section => (
      <section class="mb-12">
        <h2 class="text-2xl font-bold uppercase border-b-2 border-orange mb-6 pb-2">
          {section.title}
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {section.items.map(item => (
            <div class="p-4 rounded-lg shadow-sm">
              <div class="flex justify-between items-baseline">
                <h3 class="font-semibold text-lg">{item.name}</h3>
                <span class="text-md font-medium text-orange-500">${item.price.toFixed(2)}</span>
              </div>
              {item.desc && <p class="mt-2 text-gray-600 text-sm">{item.desc}</p>}
            </div>
          ))}
        </div>
      </section>
    ))}

    <!-- Disclaimer -->
    <p class="text-sm text-gray-500 mt-8">
      *Consuming raw or undercooked meats may increase your risk of foodborne illness.
    </p>
  </main>
</Layout>