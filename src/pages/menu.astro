export const frontmatter = {
  title: "Rosita's Menu | New Mexican Dishes in Westminster | Authentic Mexican Food",
  description: "Explore Rosita's full menu featuring authentic New Mexican cuisine. Enjoy our famous green chile dishes, breakfast burritos, enchiladas, and homemade desserts in Westminster. Gluten-free options available.",
  metaImage: "/rositas-menu.jpg",
  canonicalUrl: "https://rositas.biz/menu",
  structuredData: {
    "@context": "https://schema.org",
    "@type": "Menu",
    "name": "Rosita's New Mexican Cafe Menu",
    "image": "/rositas-menu.jpg",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://rositas.biz/menu"
    },
    "hasMenuSection": [
      {
        "@type": "MenuSection",
        "name": "New Mex Plates",
        "description": "Authentic New Mexican entrees including Carne Adovada, Chile Rellenos, and our famous Green Chile dishes",
        "hasMenuItem": [
          // Add 3-4 key items from each section
        ]
      },
      // Repeat for other sections
    ]
  }
};
---

<Layout {...frontmatter}>

  <main class="container mx-auto px-4 py-36">
    <h1 class="text-4xl font-bold text-center mb-8">Authentic New Mexican Menu in Westminster</h1>
    <p class="text-lg text-center max-w-2xl mx-auto mb-12">
      Since 1963, Rosita's has served traditional New Mexican recipes made with fresh ingredients. 
      Explore our famous green chile dishes, homemade tamales, and signature breakfast burritos. 
      All dishes made fresh daily in our Westminster kitchen.
    </p>

    <div class="text-center mb-16">
      <h2 class="text-2xl font-bold mb-4">Customer Favorites</h2>
      <ul class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
        <li>Green Chile Pork</li>
        <li>Breakfast Burritos</li>
        <li>Carne Adovada</li>
        <li>Sopapillas</li>
        <li>Chile Rellenos</li>
        <li>Huevos Rancheros</li>
        <li>Navajo Tacos</li>
        <li>Flan</li>
      </ul>
    </div>

    <!-- Menu Sections -->
    {sections.map(section => (
      <section class="mb-12">
        <h2 class="text-2xl font-bold uppercase border-b-2 border-orange mb-6 pb-2">
          {section.title}
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {section.items.map(item => (
            <div class="p-4 rounded-lg shadow-sm" itemscope itemtype="https://schema.org/MenuItem">
              <div class="flex justify-between items-baseline">
                <h3 class="font-semibold text-lg" itemprop="name">{item.name}</h3>
                <span class="text-md font-medium text-orange-500" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                  <span itemprop="priceCurrency" content="USD">$</span>
                  <span itemprop="price">{item.price.toFixed(2)}</span>
                </span>
              </div>
              {item.desc && <p class="mt-2 text-gray-600 text-sm" itemprop="description">{item.desc}</p>}
            </div>
          ))}
        </div>
      </section>
    ))}

    <!-- Disclaimer -->
    <p class="text-sm text-gray-500 mt-8">
      *Consuming raw or undercooked meats may increase your risk of foodborne illness.
    </p>
  </main>
</Layout>