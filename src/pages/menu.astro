	canonicalUrl: "https://rositas.biz/menu",
	structuredData: {
		"@context": "https://schema.org",
		"@type": "Cafe",
		"name": "Rosita's Southwest Cafe",
		"image": "/Rositas-menu.webp",
		"address": {
			"@type": "PostalAddress",
			"streetAddress": "8050 N Federal Blvd",
			"addressLocality": "Westminster",
			"addressRegion": "CO",
			"postalCode": "80031",
			"addressCountry": "US"
		},
		"geo": {
			"@type": "GeoCoordinates",
			"latitude": "39.833333",
			"longitude": "-105.016667"
		},
		"url": "https://rositas.biz",
		"telephone": "303-430-9155",
		"servesCuisine": ["Southwest", "Mexican", "Southwestern"],
		"priceRange": "$$",
		"openingHours": "[Mo-Su 7:00-20:00]",
		"menu": {
			"@type": "Menu",
			"name": "Rosita's Full Menu",
			"hasMenuSection": sections.map(section => ({
				"@type": "MenuSection",
				"name": section.title,
				"description": `${section.title} - Authentic Southwest dishes at Rosita's Cafe Westminster.`,
				"hasMenuItem": section.items.map(item => ({
					"@type": "MenuItem",
					"name": item.name,
					"description": item.desc,
					"offers": {
						"@type": "Offer",
						"price": item.price.toFixed(2),
						"priceCurrency": "USD"
					}
				}))
			}))
		}
	}
};
---

<Layout 
  title={frontmatter.title}
  description={frontmatter.description}
  metaImage={frontmatter.metaImage}
  canonicalUrl={frontmatter.canonicalUrl}
  structuredData={frontmatter.structuredData}
>
  <main class="container mx-auto px-4 py-36">
    <h1 class="text-3xl font-bold text-center mb-8" itemprop="name">Rosita's Southwest Cafe Menu</h1>
    <!-- Menu Sections -->
    {sections.map(section => (
      <section class="mb-12" itemprop="hasMenuSection">
        <h2 class="text-2xl font-bold uppercase border-b-2 border-orange mb-6 pb-2" itemprop="name">
          {section.title}
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {section.items.map(item => (
            <div class="p-4 rounded-lg shadow-sm" itemprop="hasMenuItem">
              <div class="flex justify-between items-baseline">
                <h3 class="font-semibold text-lg" itemprop="name">{item.name}</h3>
                <span class="text-md font-medium text-orange-500" itemprop="offers">
                  {item.hasStartingPrice ? 'Starting at $' : '$'}
                  <span itemprop="price">{item.price.toFixed(2)}</span>
                </span>
              </div>
              {item.desc && <p class="mt-2 text-gray-600 text-sm" itemprop="description">{item.desc}</p>}
            </div>
          ))}
        </div>
      </section>
    ))}

    <!-- Add additional SEO content -->
    <div class="mt-12 text-gray-700">
      <h2 class="text-xl font-bold mb-4">About Our Menu</h2>
      <p class="mb-4">
        Experience authentic Southwest cuisine at Rosita's Cafe in Westminster, Colorado. Our family recipes have been perfected over generations, featuring fresh ingredients and traditional cooking methods. From our famous green chile to hand-rolled enchiladas, every dish is prepared with care and attention to detail.
      </p>
      <p class="mb-4">
        We offer vegetarian options, gluten-sensitive choices, and can accommodate most dietary restrictions. All our salsas and sauces are made fresh daily. Don't forget to try our homemade sopapillas and traditional Southwest desserts!
      </p>
    </div>

    <!-- Disclaimer with allergen information -->
    <div class="text-sm text-gray-500 mt-8">
      <p class="mb-2">*Consuming raw or undercooked meats may increase your risk of foodborne illness.</p>
      <p>Please inform your server of any food allergies. Prices subject to change. Not all ingredients are listed on the menu.</p>
    </div>
  </main>
</Layout>