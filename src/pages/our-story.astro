---
import Layout from '../layouts/Layout.astro';
import FeaturedCards from '../components/FeaturedCards.astro';

const storyCard = {
  title: "Our Story",
  subtitle: "NEW MEXICAN FOOD RECIPES PASSED DOWN SINCE 1963",
  description: `Rosita's Mexican Restaurant has a rich history dating back to 1963, when it was founded by Paul Ortega in a small space on West Colfax. Known affectionately as little Rosita's, the restaurant quickly gained a following thanks to Paul's commitment to perfecting traditional New Mexican recipes passed down from his family.
After finding success with little Rosita's and his landscaping business, Paul took a bold step and secured a larger building on West Colfax, which he transformed into a popular restaurant and bar. In the mid-1970s, Rosita's on West Colfax became a destination for foodies and music lovers from all over North and West Denver, who came to enjoy the delicious New Mexican cuisine and live music.
In the late 1980s, Pie (Paul's daughter) and Chris opened a second location of Rosita's in a Westminster shopping center on 84th & Federal. Like Paul, they focused on creating and serving the best New Mexican food possible. In the early 2000s, they moved the restaurant to its current location on 8050 N Federal Blvd, where it continues to thrive and serve delicious, authentic New Mexican cuisine to this day.`,
  image: "/paul_ortega.webp",
};

const cards = [storyCard];

// Enhanced SEO metadata
export const frontmatter = {
  title: "Our Story - Family-Owned New Mexican Restaurant Since 1963 | Rosita's",
  description: "Discover Rosita's rich heritage since 1963. Founded by Paul Ortega in Denver, we serve authentic Southwestern recipes passed down through generations. Now located in Westminster, CO at 8050 N Federal Blvd.",
  canonicalUrl: "https://rositas.biz/our-story",
  metaImage: "/paul_ortega.webp",
  metaImageAlt: "Paul Ortega, founder of Rosita's Mexican Restaurant",
  // Adding structured data for better SEO
  structuredData: {
    "@context": "https://schema.org",
    "@type": "Restaurant",
    "name": "Rosita's New Mexican Restaurant",
    "image": "https://rositas.biz/paul_ortega.webp",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "8050 N Federal Blvd",
      "addressLocality": "Westminster",
      "addressRegion": "CO",
      "postalCode": "80221",
      "addressCountry": "US"
    },
    "servesCuisine": "New Mexican, Southwest Mexican",
    "priceRange": "$$",
    "foundingDate": "1963",
    "founder": {
      "@type": "Person",
      "name": "Paul Ortega"
    }
  }
};
---

<Layout {...frontmatter}>
  <main class="pt-16 md:pt-32">
    <article>
      <FeaturedCards cards={cards} />
    </article>
  </main>
</Layout> 