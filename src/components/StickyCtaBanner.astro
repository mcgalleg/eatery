---
const phoneNumber = '7207978897';
const email = 'catering@rositas.biz';
import { ContactDrawer } from './ContactDrawer';
---

<div class="fixed bottom-0 left-0 right-0 bg-white shadow-lg z-50">
  <div class="container mx-auto px-4 py-3 flex items-center justify-between">
    <div class="hidden md:block">
      <h3 class="text-lg font-semibold">Ready to Book Your Catering?</h3>
      <p class="text-sm text-gray-600">Get a free quote today!</p>
    </div>
    
    <div class="flex items-center gap-4">
      <a 
        href={`tel:${phoneNumber}`}
        class="flex items-center gap-2 px-4 py-2 bg-grey text-white rounded-full hover:bg-orange transition-opacity"
      >
        📞 <span>Call Now</span>
      </a>
      
      <a 
        href={`mailto:${email}`}
        class="flex items-center gap-2 px-4 py-2 bg-grey text-white rounded-full hover:bg-orange transition-opacity"
      >
        ✉️ <span>Email Us</span>
      </a>
      
      <button 
        id="openQuoteDrawer"
        class="px-6 py-2 bg-orange text-white rounded-full hover:bg-grey transition-opacity font-semibold"
      >
        Request a Quote
      </button>
    </div>
  </div>
</div>

<ContactDrawer client:load isOpen={false} onClose={() => {}} />

<script>
  function setupDrawer() {
    const openButton = document.getElementById('openQuoteDrawer');
    if (!openButton) return;

    const handleClick = () => {
      const drawerEvent = new CustomEvent('toggleDrawer', {
        detail: { isOpen: true },
        bubbles: true,
      });
      window.dispatchEvent(drawerEvent);
    };

    // Remove existing listeners to prevent duplicates
    openButton.removeEventListener('click', handleClick);
    // Add new listener
    openButton.addEventListener('click', handleClick);
  }

  // Setup on initial load
  setupDrawer();

  // Setup on view transitions
  document.addEventListener('astro:page-load', setupDrawer);
</script>

<style>
  @media (max-width: 768px) {
    .flex.items-center.gap-4 {
      width: 100%;
      justify-content: space-between;
    }
    
    .flex.items-center.gap-4 a {
      padding: 0.5rem;
      font-size: 0.875rem;
    }
    
    .flex.items-center.gap-4 a span {
      display: none;
    }
  }
</style> 